# =============================================================================
# mi EconomIA — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# SUPABASE (required for production)
# ---------------------------------------------------------------------------
# Get these from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key

# ---------------------------------------------------------------------------
# MERCADOPAGO (required for payments)
# ---------------------------------------------------------------------------
# Frontend: public key only (safe to expose)
# Get from: https://www.mercadopago.com.ar/developers/panel/app
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (set in Supabase Dashboard → Settings → Secrets)
# These should NEVER be in frontend .env — they go in Supabase secrets
# ---------------------------------------------------------------------------
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret-from-mp-dashboard
# SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key (auto-provided in Edge Functions)
